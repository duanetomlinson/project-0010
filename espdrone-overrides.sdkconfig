# ESP-FLY project-0010 board overrides for esp-drone
# Board: Waveshare ESP32-S3-Zero + 2x DRV8833 (single-input drive)
#
# Applied by appending to esp-drone/sdkconfig.defaults.esp32s3.
# If esp-drone/ is re-cloned, re-append this file:
#   cat espdrone-overrides.sdkconfig >> esp-drone/sdkconfig.defaults.esp32s3
# (defaults only take effect on a fresh build: delete esp-drone/sdkconfig
# first if it exists, then idf.py set-target esp32s3 && idf.py build)
#
# Build fixes applied in the esp-drone/ checkout (2026-08-19):
# - esp-now 2.1.1 vendored at esp-drone/components/espressif__esp-now
#   (latest 2.5.x needs configRUN_TIME_COUNTER_TYPE, absent in IDF
#   v5.0's FreeRTOS), referenced via `override_path` from BOTH
#     components/drivers/general/wifi/idf_component.yml
#     components/core/crazyflie/idf_component.yml
#   One local patch in it: espnow_console.c gets a fallback
#   CONFIG_ESP_CONSOLE_UART_BAUDRATE define for USB-console builds.
# - Console moved to USB-Serial/JTAG (CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG)
#   so logs are visible on the S3-Zero (no UART pads needed).
# Toolchain: ESP-IDF release/v5.0 with Python 3.11
# (~/esp/esp-idf-v5.0, shim at ~/esp/pybin/python3).
#
# Motor map VERIFIED by per-pin isolation runs 2026-08-19.
# ESP-Drone motor numbering (Crazyflie convention):
#   M1=front-right CCW, M2=rear-right CW, M3=rear-left CCW, M4=front-left CW
CONFIG_MOTOR01_PIN=1
CONFIG_MOTOR02_PIN=2
CONFIG_MOTOR03_PIN=4
CONFIG_MOTOR04_PIN=3

# I2C0: MPU6050 (0x68) + BMP280 (0x76, ignored by esp-drone)
CONFIG_I2C0_PIN_SDA=10
CONFIG_I2C0_PIN_SCL=9

# MPU6050 data-ready interrupt -- GY-521 INT pin soldered to GPIO 7.
# MANDATORY: the sensor task blocks until this ISR fires.
CONFIG_MPU_PIN_INT=7

# Unique AP SSID per drone (final SSID gets -MAC appended)
CONFIG_WIFI_BASE_SSID="ESPFLY-0010"

# Status LEDs: none wired on this build. Defaults (blue=7, green=9,
# red=8) collide with MPU INT (7) and I2C SCL (9) -- the LED task
# would toggle them mid-flight. Parked on free pins instead.
CONFIG_LED_PIN_BLUE=11
CONFIG_LED_PIN_GREEN=12
CONFIG_LED_PIN_RED=13

# Battery-voltage ADC: default GPIO2 = our rear-right motor pin --
# putting it in analog mode disconnects that motor's PWM (found live:
# right-side motors dead under app control). Moved to GPIO 8, the only
# free ADC1-capable pin. NOTE: also requires the code patch in
# esp-drone/components/drivers/general/adc/adc_esp32.c -- the S2/S3
# channel is hardcoded ADC_CHANNEL_1 (GPIO2); change to ADC_CHANNEL_7
# (GPIO8). Nothing is wired to GPIO 8, so battery readings are noise.
CONFIG_ADC1_PIN=8
